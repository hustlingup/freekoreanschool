    { "id": 37, "stage": 3, "type": "syllable_builder", "consonant": "ㅂ", "vowel": "ㅏ", "result": "바", "audio": "바", "meaning": "ba — as in 바나나 (banana)" },
    { "id": 38, "stage": 3, "type": "syllable_builder", "consonant": "ㄴ", "vowel": "ㅏ", "result": "나", "audio": "나", "meaning": "na — as in 나 (me)" },
    { "id": 39, "stage": 3, "type": "syllable_builder", "consonant": "ㅅ", "vowel": "ㅏ", "result": "사", "audio": "사", "meaning": "sa — as in 사랑 (love)" },
    { "id": 40, "stage": 3, "type": "syllable_builder", "consonant": "ㄱ", "vowel": "ㅗ", "result": "고", "audio": "고", "meaning": "go — as in 고마워 (thank you)" },
    { "id": 41, "stage": 3, "type": "syllable_builder", "consonant": "ㅎ", "vowel": "ㅏ", "result": "하", "audio": "하", "meaning": "ha — as in 하늘 (sky)" },
    { "id": 42, "stage": 3, "type": "syllable_builder", "consonant": "ㅁ", "vowel": "ㅜ", "result": "무", "audio": "무", "meaning": "mu — as in 무엇 (what)" },

    { "id": 43, "stage": 4, "type": "card_reveal", "char": "ㄲ", "jamo": "ㄲ", "romanization": "kk", "audio": "쌍기역", "hint": "Tense 'k' — hold your breath then release. No air puff." },
    { "id": 44, "stage": 4, "type": "card_reveal", "char": "ㄸ", "jamo": "ㄸ", "romanization": "tt", "audio": "쌍디귿", "hint": "Tense 't' — throat tightens before releasing. Distinct from ㄷ and ㅌ." },
    { "id": 45, "stage": 4, "type": "card_reveal", "char": "ㅃ", "jamo": "ㅃ", "romanization": "pp", "audio": "쌍비읍", "hint": "Tense 'p' — lips press hard before popping open. No air escapes." },
    { "id": 46, "stage": 4, "type": "card_reveal", "char": "ㅆ", "jamo": "ㅆ", "romanization": "ss", "audio": "쌍시옷", "hint": "Tense 's' — a sharp, tight hiss. Used in 있다 (to exist / to have)." },
    { "id": 47, "stage": 4, "type": "card_reveal", "char": "ㅉ", "jamo": "ㅉ", "romanization": "jj", "audio": "쌍지읒", "hint": "Tense 'j' — sharper and more abrupt than ㅈ. No air burst." },
    { "id": 48, "stage": 4, "type": "card_reveal", "char": "ㅋ", "jamo": "ㅋ", "romanization": "k (aspirated)", "audio": "키읔", "hint": "Aspirated — a strong burst of air follows the consonant." },
    { "id": 49, "stage": 4, "type": "card_reveal", "char": "ㅌ", "jamo": "ㅌ", "romanization": "t (aspirated)", "audio": "티읕", "hint": "Aspirated — tongue snaps off the palate with a puff of air." },
    { "id": 50, "stage": 4, "type": "card_reveal", "char": "ㅍ", "jamo": "ㅍ", "romanization": "p (aspirated)", "audio": "피읖", "hint": "Aspirated — lips burst open with a pop of air. Like 'pot'." },
    { "id": 51, "stage": 4, "type": "card_reveal", "char": "ㅊ", "jamo": "ㅊ", "romanization": "ch (aspirated)", "audio": "치읓", "hint": "Aspirated 'ch' — like 'cheese' at the start. Air comes out." },
    { "id": 52, "stage": 4, "type": "card_reveal", "char": "ㅎ", "jamo": "ㅎ", "romanization": "h (breathy)", "audio": "히읗", "hint": "A breathy aspirated consonant. The most air of any Korean consonant." },

