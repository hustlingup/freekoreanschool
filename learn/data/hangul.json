    { "id": 59, "stage": 5, "type": "card_reveal", "char": "에", "jamo": "ㅔ", "romanization": "e", "audio": "에", "hint": "ㅓ + ㅣ combined. Like 'e' in 'bed'. Sounds the same as 애 today." },
    { "id": 60, "stage": 5, "type": "card_reveal", "char": "얘", "jamo": "ㅒ", "romanization": "yae", "audio": "얘", "hint": "ㅑ + ㅣ. Rare — appears in 얘 (this child, colloquial)." },
    { "id": 61, "stage": 5, "type": "card_reveal", "char": "예", "jamo": "ㅖ", "romanization": "ye", "audio": "예", "hint": "ㅕ + ㅣ. Like 'ye' in 'yes'. 예쁘다 = beautiful." },
    { "id": 62, "stage": 5, "type": "card_reveal", "char": "와", "jamo": "ㅘ", "romanization": "wa", "audio": "와", "hint": "ㅗ + ㅏ. Like 'wa' in 'water'. 와! = Wow!" },
    { "id": 63, "stage": 5, "type": "card_reveal", "char": "왜", "jamo": "ㅙ", "romanization": "wae", "audio": "왜", "hint": "ㅗ + ㅐ. Sounds like 'wae'. 왜 = why." },
    { "id": 64, "stage": 5, "type": "card_reveal", "char": "외", "jamo": "ㅚ", "romanization": "oe", "audio": "외", "hint": "ㅗ + ㅣ. Like 'we'. 외국인 = foreigner." },
    { "id": 65, "stage": 5, "type": "card_reveal", "char": "워", "jamo": "ㅝ", "romanization": "wo", "audio": "워", "hint": "ㅜ + ㅓ. Like 'wuh'. 뭐 = what (colloquial)." },
    { "id": 66, "stage": 5, "type": "card_reveal", "char": "웨", "jamo": "ㅞ", "romanization": "we", "audio": "웨", "hint": "ㅜ + ㅔ. Like 'we'. Very rare in Korean." },
    { "id": 67, "stage": 5, "type": "card_reveal", "char": "위", "jamo": "ㅟ", "romanization": "wi", "audio": "위", "hint": "ㅜ + ㅣ. Like 'wee'. 위 = above / stomach." },
    { "id": 68, "stage": 5, "type": "card_reveal", "char": "의", "jamo": "ㅢ", "romanization": "ui", "audio": "의", "hint": "ㅡ + ㅣ. A unique glide. 의사 = doctor. Used as possessive particle 의." },

