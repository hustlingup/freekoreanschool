  "steps": [
    { "id": 1, "stage": 1, "type": "card_reveal", "char": "아", "jamo": "ㅏ", "romanization": "a", "audio": "아", "hint": "Open your mouth wide, like saying 'ah' at the doctor." },
    { "id": 2, "stage": 1, "type": "card_reveal", "char": "야", "jamo": "ㅑ", "romanization": "ya", "audio": "야", "hint": "Like 'ya' in 'yard'. The extra stroke means a 'y' is added." },
    { "id": 3, "stage": 1, "type": "card_reveal", "char": "어", "jamo": "ㅓ", "romanization": "eo", "audio": "어", "hint": "Similar to 'uh' or 'o' in 'the other'. Lips slightly rounded." },
    { "id": 4, "stage": 1, "type": "card_reveal", "char": "여", "jamo": "ㅕ", "romanization": "yeo", "audio": "여", "hint": "Like 'yuh' with rounded lips. Two strokes = 'y' prefix." },
    { "id": 5, "stage": 1, "type": "card_reveal", "char": "오", "jamo": "ㅗ", "romanization": "o", "audio": "오", "hint": "Like 'o' in 'more'. Round your lips as if blowing a candle." },
    { "id": 6, "stage": 1, "type": "card_reveal", "char": "요", "jamo": "ㅛ", "romanization": "yo", "audio": "요", "hint": "Like 'yo!' — two strokes add the 'y'. Used a lot in speech." },
    { "id": 7, "stage": 1, "type": "card_reveal", "char": "우", "jamo": "ㅜ", "romanization": "u", "audio": "우", "hint": "Like 'oo' in 'boot'. The line points DOWN — mouth drops." },
    { "id": 8, "stage": 1, "type": "card_reveal", "char": "유", "jamo": "ㅠ", "romanization": "yu", "audio": "유", "hint": "Like 'you'. Two downward strokes signal the 'y' prefix." },
    { "id": 9, "stage": 1, "type": "card_reveal", "char": "으", "jamo": "ㅡ", "romanization": "eu", "audio": "으", "hint": "Like the 'e' sound when you're unsatisfied: 'euugh'. Flat lips." },
    { "id": 10, "stage": 1, "type": "card_reveal", "char": "이", "jamo": "ㅣ", "romanization": "i", "audio": "이", "hint": "Like 'ee' in 'bee'. A simple vertical stroke — pure high front vowel." },

    { "id": 11, "stage": 1, "type": "match_quiz", "prompt": "Which vowel sounds like 'a' (as in 'father')?", "choices": ["ㅏ", "ㅗ", "ㅜ", "ㅣ"], "correct": "ㅏ" },
    { "id": 12, "stage": 1, "type": "match_quiz", "prompt": "Which vowel sounds like 'o' (as in 'more')?", "choices": ["ㅓ", "ㅗ", "ㅡ", "ㅑ"], "correct": "ㅗ" },
    { "id": 13, "stage": 1, "type": "match_quiz", "prompt": "Which vowel sounds like 'ee' (as in 'bee')?", "choices": ["ㅓ", "ㅛ", "ㅣ", "ㅠ"], "correct": "ㅣ" },
    { "id": 14, "stage": 1, "type": "match_quiz", "prompt": "ㅠ romanizes as…", "choices": ["u", "eu", "yo", "yu"], "correct": "yu" },
    { "id": 15, "stage": 1, "type": "match_quiz", "prompt": "ㅡ sounds like…", "choices": ["ya", "i", "eu", "yo"], "correct": "eu" },

    { "id": 16, "stage": 2, "type": "card_reveal", "char": "ㄱ", "jamo": "ㄱ", "romanization": "g / k", "audio": "기역", "example_word": "가다", "example_meaning": "to go", "hint": "Shaped like the back of the throat blocking airflow." },
    { "id": 17, "stage": 2, "type": "card_reveal", "char": "ㄴ", "jamo": "ㄴ", "romanization": "n", "audio": "니은", "example_word": "나", "example_meaning": "I / me", "hint": "Shaped like a tongue tip touching the roof of the mouth." },
    { "id": 18, "stage": 2, "type": "card_reveal", "char": "ㄷ", "jamo": "ㄷ", "romanization": "d / t", "audio": "디귿", "example_word": "다", "example_meaning": "all / every", "hint": "Like ㄴ with a roof — tongue fully blocks the palate." },
    { "id": 19, "stage": 2, "type": "card_reveal", "char": "ㄹ", "jamo": "ㄹ", "romanization": "r / l", "audio": "리을", "example_word": "리", "example_meaning": "reason (prefix)", "hint": "A flap — between English 'r' and 'l'. Tongue taps the palate." },
    { "id": 20, "stage": 2, "type": "card_reveal", "char": "ㅁ", "jamo": "ㅁ", "romanization": "m", "audio": "미음", "example_word": "마음", "example_meaning": "heart / mind", "hint": "Shaped like closed lips pressing together to make 'm'." },
    { "id": 21, "stage": 2, "type": "card_reveal", "char": "ㅂ", "jamo": "ㅂ", "romanization": "b / p", "audio": "비읍", "example_word": "밥", "example_meaning": "rice / meal", "hint": "Shaped like lips opening to release the 'b' or 'p' sound." },
    { "id": 22, "stage": 2, "type": "card_reveal", "char": "ㅅ", "jamo": "ㅅ", "romanization": "s", "audio": "시옷", "example_word": "사람", "example_meaning": "person", "hint": "Shaped like two teeth — air hisses through for the 's' sound." },
    { "id": 23, "stage": 2, "type": "card_reveal", "char": "ㅇ", "jamo": "ㅇ", "romanization": "ng / silent", "audio": "이응", "example_word": "아이", "example_meaning": "child", "hint": "Silent at the start of a syllable. Sounds like 'ng' at the end." },
    { "id": 24, "stage": 2, "type": "card_reveal", "char": "ㅈ", "jamo": "ㅈ", "romanization": "j", "audio": "지읒", "example_word": "지금", "example_meaning": "now", "hint": "Like 'j' in 'juice'. Tongue presses behind upper teeth." },
    { "id": 25, "stage": 2, "type": "card_reveal", "char": "ㅊ", "jamo": "ㅊ", "romanization": "ch", "audio": "치읓", "example_word": "차", "example_meaning": "tea / car", "hint": "Aspirated 'ch' — a puff of air comes out. Like 'ch' in 'cheese'." },
    { "id": 26, "stage": 2, "type": "card_reveal", "char": "ㅋ", "jamo": "ㅋ", "romanization": "k", "audio": "키읔", "example_word": "커피", "example_meaning": "coffee", "hint": "Aspirated 'k' — strong puff of air. Hold a tissue and it flutters." },
    { "id": 27, "stage": 2, "type": "card_reveal", "char": "ㅌ", "jamo": "ㅌ", "romanization": "t", "audio": "티읕", "example_word": "타다", "example_meaning": "to ride", "hint": "Aspirated 't' — like 't' in 'ten' (at word start). Strong burst." },
    { "id": 28, "stage": 2, "type": "card_reveal", "char": "ㅍ", "jamo": "ㅍ", "romanization": "p", "audio": "피읖", "example_word": "파", "example_meaning": "green onion", "hint": "Aspirated 'p' — like 'p' in 'pot'. Lips pop apart with air." },
    { "id": 29, "stage": 2, "type": "card_reveal", "char": "ㅎ", "jamo": "ㅎ", "romanization": "h", "audio": "히읗", "example_word": "하늘", "example_meaning": "sky", "hint": "A breathy 'h' — like exhaling warmth onto your hand." },

