 {
  "key": "Discover the beauty of Korea through language, culture, K-pop, travel, and cuisine — with free lessons designed for learners worldwide.",
  "value": "Descubra a beleza da Coreia através do idioma, da cultura, do K-pop, das viagens e da culinária — com aulas gratuitas criadas para quem aprende no mundo todo."
 },
 {
  "key": "Learn the Korean alphabet in just 2 hours. 한글 (Hangul) is remarkably logical — once you know the 24 basic letters, you can read anything.",
  "value": "Aprenda o alfabeto coreano em apenas 2 horas. 한글 (Hangul) é surpreendentemente lógico — assim que você conhecer as 24 letras básicas, poderá ler qualquer coisa."
 },
 {
  "key": "Learn Korean naturally through your favourite songs. Line-by-line breakdowns with vocabulary, grammar notes, and pronunciation guides.",
  "value": "Aprenda coreano naturalmente através das suas músicas favoritas. Explicações linha por linha com vocabulário, notas de gramática e guias de pronúncia."
 },
 {
  "key": "Pick up everyday Korean from your favourite dramas. Contextual vocabulary lists organised by show, genre, and proficiency level.",
  "value": "Aprenda coreano do dia a dia com seus doramas favoritos. Listas de vocabulário contextual organizadas por série, gênero e nível de proficiência."
 },
 {
  "key": "From 김치 (kimchi) to 삼겹살 (samgyeopsal) — explore the rich vocabulary of Korean cuisine with pronunciation and cultural context.",
  "value": "De 김치 (kimchi) a 삼겹살 (samgyeopsal) — explore o rico vocabulário da culinária coreana com pronúncia e contexto cultural."
 },
 {
  "key": "Whether you are just starting or aiming for fluency, we have a clear roadmap to take you there step by step.",
  "value": "Seja você iniciante ou esteja buscando fluência, temos um roteiro claro para te levar até lá passo a passo."
 },
 {
  "key": "Language is the gateway — immerse yourself in Korean pop culture, food, and beauty to supercharge your learning.",
  "value": "O idioma é a porta de entrada — mergulhe na cultura pop coreana, na comida e na beleza para turbinar seu aprendizado."
 },
 {
  "key": "From BTS to BLACKPINK — the most common Korean words and phrases used by your favourite K-Pop artists, with pronunciation guides.",
  "value": "De BTS a BLACKPINK — as palavras e frases coreanas mais comuns usadas pelos seus artistas de K-Pop favoritos, com guias de pronúncia."
 },
 {
  "key": "Korean dramas are packed with emotional vocabulary. Learn how characters express joy, sadness, anger, and love in authentic Korean.",
  "value": "Os doramas coreanos são repletos de vocabulário emocional. Aprenda como os personagens expressam alegria, tristeza, raiva e amor em coreano autêntico."
 },
 {
  "key": "Essential phrases for ordering food, asking for the bill, and navigating a Korean restaurant menu with confidence.",
  "value": "Frases essenciais para pedir comida, solicitar a conta e navegar com confiança pelo cardápio de um restaurante coreano."
 },
 {
  "key": "Explore the world of K-Beauty with essential vocabulary for skincare routines, cosmetics, and Korean beauty trends.",
  "value": "Explore o mundo do K-Beauty com vocabulário essencial para rotinas de skincare, cosméticos e tendências de beleza coreana."
 },
 {
  "key": "Learn the language of every destination. From bustling Seoul to the serene shores of Jeju — your AI travel guide is ready.",
  "value": "Aprenda o idioma de cada destino. Da agitada Seul às serenas praias de Jeju — seu guia de viagem com IA está pronto."
 },
 {
  "key": "South Korea's dazzling capital — from the ancient palaces of Gyeongbokgung to the neon streets of Gangnam and Hongdae.",
  "value": "A deslumbrante capital da Coreia do Sul — dos antigos palácios de Gyeongbokgung às ruas neon de Gangnam e Hongdae."
 },
 {
  "key": "Korea's vibrant port city with stunning beaches, fresh seafood markets, and a unique dialect worth discovering.",
  "value": "A vibrante cidade portuária da Coreia, com praias deslumbrantes, mercados de frutos do mar frescos e um dialeto único que vale a pena descobrir."
 },
 {
  "key": "Korea's paradise island — volcanic landscapes, pristine beaches, tangerine groves, and the famous haenyeo diving culture.",
  "value": "A ilha paraíso da Coreia — paisagens vulcânicas, praias intocadas, pomares de tangerina e a famosa cultura de mergulho haenyeo."
 },
