    {
      "lang": "ja",
      "ref": "grammar::steps.0.rules[0]",
      "kind": "unit",
      "en": "English (SVO): I eat rice.",
      "shipped": "英語（SVO）：I eat rice."
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.0.rules[1]",
      "kind": "unit",
      "en": "Korean (SOV): 나는 밥을 먹어요. (I rice eat.)",
      "shipped": "韓国語（SOV）：나는 밥을 먹어요.（私 ご飯 食べる）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.0.rules[2]",
      "kind": "unit",
      "en": "Tip: Listen for the final word — that's the verb, the action!",
      "shipped": "ヒント：最後の単語をよく聞いてください——それが動詞、つまり動作です！"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.0.tip.label",
      "kind": "unit",
      "en": "Grammar Tip",
      "shipped": "文法のヒント"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.0.tip.text",
      "kind": "unit",
      "en": "Once you know the verb comes last, everything clicks. The rest of the sentence can rearrange — Korean speakers use particles to keep things clear.",
      "shipped": "動詞が最後に来ることさえ分かれば、すべてが腑に落ちます。文の他の部分は入れ替えても構いません——韓国語話者は助詞を使って意味を明確にします。"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.3.rules[0]",
      "kind": "unit",
      "en": "은/는 → Topic marker (은 after consonant, 는 after vowel)",
      "shipped": "은/는 → 主題を表す助詞（子音の後は은、母音の後は는）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.3.rules[1]",
      "kind": "unit",
      "en": "이/가 → Subject marker (이 after consonant, 가 after vowel)",
      "shipped": "이/가 → 主格を表す助詞（子音の後は이、母音の後は가）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.3.rules[2]",
      "kind": "unit",
      "en": "을/를 → Object marker (을 after consonant, 를 after vowel)",
      "shipped": "을/를 → 目的語を表す助詞（子音の後は을、母音の後は를）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.3.rules[3]",
      "kind": "unit",
      "en": "에 → Location / Direction",
      "shipped": "에 → 場所／方向"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.3.rules[4]",
      "kind": "unit",
      "en": "에서 → Location of action",
      "shipped": "에서 → 動作が行われる場所"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.3.rules[5]",
      "kind": "unit",
      "en": "의 → Possessive ('s / of)",
      "shipped": "의 → 所有格（〜の）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.11.body",
      "kind": "unit",
      "en": "All Korean verbs in dictionary form end in 다 (da). Remove 다 to get the verb stem, then add an ending.",
      "shipped": "韓国語の動詞は辞書形がすべて다（da）で終わります。다を取ると語幹になり、そこに語尾を付け加えます。"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.11.rules[0]",
      "kind": "unit",
      "en": "가다 (to go) → stem: 가-",
      "shipped": "가다（行く）→ 語幹：가-"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.11.rules[1]",
      "kind": "unit",
      "en": "먹다 (to eat) → stem: 먹-",
      "shipped": "먹다（食べる）→ 語幹：먹-"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.11.rules[2]",
      "kind": "unit",
      "en": "공부하다 (to study) → stem: 공부하-",
      "shipped": "공부하다（勉強する）→ 語幹：공부하-"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.11.rules[3]",
      "kind": "unit",
      "en": "하다 (to do) → stem: 하-",
      "shipped": "하다（する）→ 語幹：하-"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.12.title",
      "kind": "unit",
      "en": "Present Tense: -아요 / -어요",
      "shipped": "現在形：-아요／-어요"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.12.body",
      "kind": "unit",
      "en": "Add -아요 after ㅏ or ㅗ stems. Add -어요 for all others. 하다 verbs use -해요.",
      "shipped": "語幹の母音がㅏまたはㅗの場合は-아요を付けます。それ以外は-어요を付けます。하다動詞は-해요を使います。"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.12.rules[0]",
      "kind": "unit",
      "en": "가다 → 가요 (go · ㅏ stem)",
      "shipped": "가다 → 가요（行く・ㅏ語幹）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.12.rules[1]",
      "kind": "unit",
      "en": "오다 → 와요 (come · ㅗ stem)",
      "shipped": "오다 → 와요（来る・ㅗ語幹）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.12.rules[2]",
      "kind": "unit",
      "en": "먹다 → 먹어요 (eat · other)",
      "shipped": "먹다 → 먹어요（食べる・その他）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.12.rules[3]",
      "kind": "unit",
      "en": "마시다 → 마셔요 (drink · other)",
      "shipped": "마시다 → 마셔요（飲む・その他）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.12.rules[4]",
      "kind": "unit",
      "en": "공부하다 → 공부해요 (study · 하다)",
      "shipped": "공부하다 → 공부해요（勉強する・하다）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.12.tip.label",
      "kind": "unit",
      "en": "Vowel Rule",
      "shipped": "母音規則"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.12.tip.text",
      "kind": "unit",
      "en": "ㅏ and ㅗ are 'bright' vowels → -아요. All other vowels are 'dark' → -어요. Once you know the stem vowel, conjugation is automatic.",
      "shipped": "ㅏとㅗは「明るい」母音→-아요。それ以外の母音はすべて「暗い」母音→-어요。語幹の母音がわかれば、活用は自動的に決まります"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.16.title",
      "kind": "unit",
      "en": "Past Tense: -았어요 / -었어요",
      "shipped": "過去形：-았어요 / -었어요"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.16.body",
      "kind": "unit",
      "en": "Add -았어요 after ㅏ/ㅗ stems and -었어요 for others. 하다 → 했어요.",
      "shipped": "ㅏ/ㅗで終わる語幹には-았어요を、それ以外には-었어요をつけます。하다 → 했어요。"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.16.rules[0]",
      "kind": "unit",
      "en": "가다 → 갔어요 (went)",
      "shipped": "가다 → 갔어요（行った）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.16.rules[1]",
      "kind": "unit",
      "en": "오다 → 왔어요 (came)",
      "shipped": "오다 → 왔어요（来た）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.16.rules[2]",
      "kind": "unit",
      "en": "먹다 → 먹었어요 (ate)",
      "shipped": "먹다 → 먹었어요（食べた）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.16.rules[3]",
      "kind": "unit",
      "en": "마시다 → 마셨어요 (drank)",
      "shipped": "마시다 → 마셨어요（飲んだ）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.16.rules[4]",
      "kind": "unit",
      "en": "공부하다 → 공부했어요 (studied)",
      "shipped": "공부하다 → 공부했어요（勉強した）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.19.title",
      "kind": "unit",
      "en": "Future Tense: -(으)ㄹ 거예요",
      "shipped": "未来形：-(으)ㄹ 거예요"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.19.body",
      "kind": "unit",
      "en": "Add -(으)ㄹ 거예요 to the verb stem to talk about future plans or predictions.",
      "shipped": "動詞の語幹に-(으)ㄹ 거예요をつけて、未来の予定や予測を表します。"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.19.rules[0]",
      "kind": "unit",
      "en": "가다 → 갈 거예요 (will go)",
      "shipped": "가다 → 갈 거예요（行く）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.19.rules[1]",
      "kind": "unit",
      "en": "먹다 → 먹을 거예요 (will eat)",
      "shipped": "먹다 → 먹을 거예요（食べる）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.19.rules[2]",
      "kind": "unit",
      "en": "공부하다 → 공부할 거예요 (will study)",
      "shipped": "공부하다 → 공부할 거예요（勉強する）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.21.body",
      "kind": "unit",
      "en": "Short negation: 안 + verb. Long negation: verb stem + 지 않아요. Cannot: 못 + verb.",
      "shipped": "短い否定：안 + 動詞。長い否定：動詞の語幹 + 지 않아요。不可能：못 + 動詞。"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.21.rules[0]",
      "kind": "unit",
      "en": "안 먹어요 (don't eat — short form)",
      "shipped": "안 먹어요（食べない——短い形）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.21.rules[1]",
      "kind": "unit",
      "en": "먹지 않아요 (don't eat — long form)",
      "shipped": "먹지 않아요（食べない——長い形）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.21.rules[2]",
      "kind": "unit",
      "en": "못 가요 (can't go — unable to)",
      "shipped": "못 가요（行けない——不可能）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.23.rules[0]",
      "kind": "unit",
      "en": "뭐 / 무엇 — What",
      "shipped": "뭐 / 무엇——何"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.23.rules[1]",
      "kind": "unit",
      "en": "누구 — Who",
      "shipped": "누구——誰"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.23.rules[2]",
      "kind": "unit",
      "en": "어디 — Where",
      "shipped": "어디——どこ"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.23.rules[3]",
      "kind": "unit",
      "en": "언제 — When",
      "shipped": "언제——いつ"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.23.rules[4]",
      "kind": "unit",
      "en": "왜 — Why",
      "shipped": "왜——なぜ"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.23.rules[5]",
      "kind": "unit",
      "en": "어떻게 — How",
      "shipped": "어떻게——どう"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.23.rules[6]",
      "kind": "unit",
      "en": "얼마 — How much",
      "shipped": "얼마——いくら"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.23.rules[7]",
      "kind": "unit",
      "en": "몇 — How many",
      "shipped": "몇——いくつ"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.23.tip.label",
      "kind": "unit",
      "en": "Grammar Tip",
      "shipped": "文法のヒント"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.23.tip.text",
      "kind": "unit",
      "en": "밥을 먹어요 = I eat rice. 밥을 먹어요? = Do you eat rice? Same words — just a rising tone at the end. No word inversion like English!",
      "shipped": "밥을 먹어요 = ご飯を食べます。밥을 먹어요? = ご飯を食べますか？ 同じ単語のまま——語尾を上げるだけです。英語のような語順の入れ替えは不要です！"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.26.rules[0]",
      "kind": "unit",
      "en": "~이에요/예요 — is/am/are (noun): 학생이에요 (I'm a student)",
      "shipped": "~이에요/예요——～です（名詞）：학생이에요（学生です）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.26.rules[1]",
      "kind": "unit",
      "en": "~고 싶어요 — want to: 한국에 가고 싶어요 (I want to go to Korea)",
      "shipped": "~고 싶어요——～したい：한국에 가고 싶어요（韓国に行きたいです）"
    },
    {
      "lang": "ja",
      "ref": "grammar::steps.26.rules[2]",
      "kind": "unit",
      "en": "~ㄹ/을 수 있어요 — can: 한국어를 할 수 있어요 (I can speak Korean)",
      "shipped": "~ㄹ/을 수 있어요——～できる：한국어를 할 수 있어요（韓国語ができます）"
    },
    {
      "lang": "ja",
