      "text": "活用"
    },
    {
      "ref": "grammar::stages.3.name",
      "text": "否定文"
    },
    {
      "ref": "grammar::stages.4.name",
      "text": "疑問文"
    },
    {
      "ref": "grammar::stages.5.name",
      "text": "文型"
    },
    {
      "ref": "grammar::stages.6.name",
      "text": "接続詞"
    },
    {
      "ref": "grammar::stages.7.name",
      "text": "と／とともに"
    },
