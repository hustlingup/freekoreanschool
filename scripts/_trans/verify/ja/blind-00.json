      "ref": "grammar::stages.14.name",
      "text": "副詞"
    },
    {
      "ref": "grammar::stages.15.name",
      "text": "名詞化"
    },
    {
      "ref": "grammar::stages.16.name",
      "text": "比較"
    },
    {
      "ref": "grammar::stages.17.name",
      "text": "好き"
    },
    {
      "ref": "grammar::stages.18.name",
      "text": "まだ／すでに"
    },
