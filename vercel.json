{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/culture/traditions",
      "destination": "/culture/koreanthing",
      "permanent": true
    },
    {
      "source": "/culture/:locale(zh-tw|ja|es|fr|de|vi|th|id|pt-br)/traditions",
      "destination": "/culture/:locale/koreanthing",
      "permanent": true
    },
    {
      "source": "/:locale(zh-tw|ja|es|fr|de|vi|th|id|pt-br)/culture",
      "destination": "/culture/:locale",
      "permanent": true
    },
    {
      "source": "/:locale(zh-tw|ja|es|fr|de|vi|th|id|pt-br)/travel",
      "destination": "/travel/:locale",
      "permanent": true
    },
    {
      "source": "/:locale(zh-tw|ja|es|fr|de|vi|th|id|pt-br)/learn",
      "destination": "/learn/:locale",
      "permanent": true
    }
  ]
}
